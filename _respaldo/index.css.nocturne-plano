@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap');

@tailwind base;
@tailwind components;
@tailwind utilities;

/*
  Nocturne — repiel del CRM XiX Tech.
  Tokens y clases de componente reescritos siguiendo el handoff de diseño
  (README: Handoff XiX Tech CRM — repiel Nocturne). Los NOMBRES de clase se
  conservan intactos (.glass-card, .nav-item, .badge-cyan, .kanban-card,
  .sidebar…) para no tener que tocar ningún .tsx en esta capa.
*/

:root {
  color-scheme: dark;
  --color-bg: #161826;
  --color-surface: #232532;
  --color-text: #e9e9ed;
  --color-accent: #9184d9;
  --color-divider: color-mix(in srgb, #e9e9ed 16%, transparent);

  --color-neutral-100: #f3f5fe;
  --color-neutral-200: #e4e7f5;
  --color-neutral-300: #cfd3e5;
  --color-neutral-400: #b2b6ca;
  --color-neutral-500: #9397ab;
  --color-neutral-600: #75798c;
  --color-neutral-700: #595d6c;
  --color-neutral-800: #3f424d;
  --color-neutral-900: #292b31;

  --color-accent-100: #f5f4ff;
  --color-accent-200: #e7e5fe;
  --color-accent-300: #d2cefd;
  --color-accent-400: #b5abfc;
  --color-accent-500: #968ae0;
  --color-accent-600: #796cbf;
  --color-accent-700: #5d5294;
  --color-accent-800: #423a6a;
  --color-accent-900: #2b2741;

  --shadow-sm: 0 0 0 1px #3f424d;
  --shadow-md: 0 0 0 1px #595d6c, 0 6px 18px rgba(0,0,0,0.55);
  --shadow-lg: 0 0 0 1px #9397ab, 0 16px 40px rgba(0,0,0,0.65);
}

html, body, #root { height: 100%; }

body {
  margin: 0;
  background-color: var(--color-bg);
  color: var(--color-text);
  font-family: 'Inter', system-ui, sans-serif;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

h1, h2, h3, h4 { font-weight: 500; letter-spacing: -0.015em; }

/* El fondo de gradientes + rejilla lo reemplaza <ParticleField /> (canvas,
   position: fixed, z-index: 0), montado una vez en App.tsx. */
#root { position: relative; z-index: 1; }

/* ─── Scrollbar ─── */
::-webkit-scrollbar { width: 4px; height: 4px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: color-mix(in srgb, var(--color-text) 12%, transparent); border-radius: 999px; }
::-webkit-scrollbar-thumb:hover { background: color-mix(in srgb, var(--color-text) 20%, transparent); }

::selection { background: color-mix(in srgb, var(--color-accent) 30%, transparent); color: var(--color-text); }

@layer components {

  /* ── Tarjeta — antes glassmorphism con blur, ahora fondo sólido + filo ── */
  .glass-card {
    background: var(--color-surface);
    border: 1px solid var(--color-neutral-800);
    border-radius: 8px;
    box-shadow: var(--shadow-sm);
    transition: border-color 0.18s ease, box-shadow 0.18s ease;
  }
  .glass-card:hover {
    border-color: var(--color-neutral-700);
    box-shadow: var(--shadow-md);
  }

  .card { @apply glass-card; }

  /* ── Ítem de navegación — la píldora cian pasa a marca de acento ── */
  .nav-item {
    @apply flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium transition-all duration-150 cursor-pointer select-none;
    color: var(--color-neutral-500);
    border-left: 2px solid transparent;
  }
  .nav-item:hover {
    background: color-mix(in srgb, var(--color-text) 5%, transparent);
    color: var(--color-neutral-100);
  }
  .nav-item.active {
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
    color: var(--color-accent-300);
    border-left-color: var(--color-accent);
  }
  .nav-item.active .nav-icon { color: var(--color-accent); }

  /* ── Botones — el primario deja de ser relleno degradado y pasa a contorno ── */
  .btn {
    @apply inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2.5 text-sm font-semibold transition-all duration-150 focus:outline-none disabled:opacity-45 disabled:cursor-not-allowed select-none;
  }
  .btn:active:not(:disabled) { transform: scale(0.98); }

  .btn-primary {
    @apply btn;
    background: transparent;
    color: var(--color-accent);
    box-shadow: inset 0 0 0 1px var(--color-accent);
  }
  .btn-primary:hover:not(:disabled) {
    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
  }
  .btn-primary:active:not(:disabled) {
    background: color-mix(in srgb, var(--color-accent) 22%, transparent);
  }

  .btn-ghost {
    @apply btn;
    background: color-mix(in srgb, var(--color-text) 5%, transparent);
    color: var(--color-neutral-400);
    border: 1px solid var(--color-neutral-800);
  }
  .btn-ghost:hover:not(:disabled) {
    background: color-mix(in srgb, var(--color-text) 8%, transparent);
    color: var(--color-neutral-100);
    border-color: var(--color-neutral-700);
  }

  .btn-danger {
    @apply btn;
    background: transparent;
    color: #d09090;
    box-shadow: inset 0 0 0 1px #935e5e;
  }
  .btn-danger:hover:not(:disabled) {
    background: rgba(208,144,144,0.14);
  }
  .btn-block { width: 100%; }

  /* ── Segmentado — conmutador de modo (login/registro), sin relleno ── */
  .seg {
    display: inline-flex;
    border: 1px solid var(--color-neutral-800);
    border-radius: 8px;
    overflow: hidden;
  }
  .seg-opt {
    flex: 1;
    padding: 7px 12px;
    font-size: 13px;
    font-weight: 500;
    text-align: center;
    cursor: pointer;
    color: var(--color-neutral-500);
    transition: color 0.15s ease, box-shadow 0.15s ease;
  }
  .seg-opt + .seg-opt { border-left: 1px solid var(--color-neutral-800); }
  .seg-opt:hover { color: var(--color-neutral-200); }
  .seg-opt.active {
    color: var(--color-accent);
    box-shadow: inset 0 0 0 1px var(--color-accent);
  }

  /* ── Input ── */
  .input {
    @apply w-full rounded-lg border px-3.5 py-2.5 text-sm transition-all duration-150 focus:outline-none;
    color: var(--color-text);
    caret-color: var(--color-accent);
    background: var(--color-surface);
    border-color: var(--color-neutral-800);
  }
  .input::placeholder { color: var(--color-neutral-600); }
  .input:hover { border-color: var(--color-neutral-700); }
  .input:focus {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-accent) 15%, transparent);
  }

  .label {
    @apply block text-xs font-medium mb-1.5;
    color: var(--color-neutral-500);
  }

  /* ── Badge — mismo rol semántico, paleta desaturada ── */
  .badge {
    @apply inline-flex items-center gap-1 rounded-full px-2.5 py-0.5 text-xs font-semibold;
  }
  .badge-cyan    { background: color-mix(in srgb, var(--color-accent) 14%, transparent); color: var(--color-accent-300); border: 1px solid color-mix(in srgb, var(--color-accent) 28%, transparent); }
  .badge-violet  { background: color-mix(in srgb, var(--color-accent) 14%, transparent); color: var(--color-accent-300); border: 1px solid color-mix(in srgb, var(--color-accent) 28%, transparent); }
  .badge-green   { background: rgba(134,178,152,0.14); color: #a9cdb6; border: 1px solid rgba(134,178,152,0.3); }
  .badge-amber   { background: rgba(201,174,125,0.14); color: #e0cba3; border: 1px solid rgba(201,174,125,0.3); }
  .badge-rose    { background: rgba(208,144,144,0.14); color: #e8b4b4; border: 1px solid rgba(208,144,144,0.3); }
  .badge-metal   { background: color-mix(in srgb, var(--color-text) 6%, transparent); color: var(--color-neutral-400); border: 1px solid var(--color-neutral-800); }
  .badge-blue    { background: color-mix(in srgb, var(--color-accent) 14%, transparent); color: var(--color-accent-300); border: 1px solid color-mix(in srgb, var(--color-accent) 28%, transparent); }

  /* ── Barra superior de las tarjetas KPI ── */
  .stat-card-cyan   { border-top: 1px solid color-mix(in srgb, var(--color-accent) 30%, transparent); }
  .stat-card-violet { border-top: 1px solid color-mix(in srgb, var(--color-accent) 30%, transparent); }
  .stat-card-green  { border-top: 1px solid rgba(134,178,152,0.3); }
  .stat-card-amber  { border-top: 1px solid rgba(201,174,125,0.3); }

  /* ── Divider — firma del sistema: se desvanece en los extremos ── */
  .divider {
    @apply h-px w-full;
    background: linear-gradient(to right,
      transparent, var(--color-divider) 48px,
      var(--color-divider) calc(100% - 48px), transparent);
  }

  /* ── Kanban card ── */
  .kanban-card {
    background: var(--color-surface);
    border: 1px solid var(--color-neutral-800);
    border-radius: 8px;
    transition: border-color 0.18s ease, box-shadow 0.18s ease, transform 0.18s ease;
    cursor: grab;
  }
  .kanban-card:hover {
    border-color: var(--color-neutral-700);
    box-shadow: var(--shadow-md);
  }
  .kanban-card:active { cursor: grabbing; }

  /* ── Fila de tabla ── */
  .table-row-hover:hover {
    background: color-mix(in srgb, var(--color-text) 4%, transparent);
  }

  /* ── Sidebar — antes blur pesado sobre casi negro, ahora fondo sólido ── */
  .sidebar {
    background: var(--color-bg);
    border-right: 1px solid var(--color-neutral-800);
  }

  /* ── Cifras — mono tabular, para que las columnas no bailen ── */
  .num {
    font-family: 'JetBrains Mono', monospace;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
  }

  /* ── Kicker — encabezado pequeño en mayúsculas, patrón repetido en los tabs ── */
  .kicker {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-neutral-500);
  }
}
